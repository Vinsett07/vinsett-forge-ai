  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.38.0",
    "eslint-config-next": "16.3.8",
    "typescript": "5.9.3",
    "@playwright/test": "1.63.0"
  },
  "type": "module"
}
